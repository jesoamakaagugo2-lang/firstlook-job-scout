{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firstlook-job-scout",
  "main": "worker/cloudflare.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "firstlook-db",
      "database_id": "2ee2930e-828b-41be-b59f-6ceed95f5570",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "OWNER_EMAIL": "jesoamakaagugo2@gmail.com"
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true
}
